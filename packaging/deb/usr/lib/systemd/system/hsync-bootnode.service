[Unit]
Description=HSYNC P2P bootstrap node (boot/1, QUIC/UDP 443, no-log)
Documentation=https://github.com/albertsdk/hsync-bootnode
After=network-online.target
Wants=network-online.target
# A crash loop must surface as a failed unit (and an alert) instead of an endless
# restart storm.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Type=notify: the unit is active only once the node has bound the QUIC/UDP
# listener and announced READY=1 (sd_notify), not as soon as it forks. The
# watchdog restarts a node whose event loop stops making progress — a wedged
# process still holds the socket, so liveness cannot be inferred from the PID.
Type=notify
NotifyAccess=main
WatchdogSec=30
# A SIGTERM stop is graceful and exits 0, so only a failure restarts the unit;
# the stop timeout bounds the transport teardown before SIGKILL is escalated.
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15
KillSignal=SIGTERM
# Host protection: the node sizes its own table/connection limits from RAM and
# CPU, and the cgroup is what keeps a runaway instance from taking the host down
# (an OOM inside the cgroup restarts the service, not the machine).
MemoryMax=512M
TasksMax=256
LimitNOFILE=8192
# No-log node: a dynamic system user (no /home; the only persisted state is the
# TLS identity), strict filesystem sandbox, allowed to bind the QUIC/UDP port
# 443. StateDirectory= makes /var/lib/hsync-bootnode writable for the identity
# file the node keeps by default via --identity below (an explicit path is
# required because a DynamicUser has no resolvable home directory, so the
# default XDG state path cannot be derived).
DynamicUser=yes
StateDirectory=hsync-bootnode
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# The (optional) group-keys file is exposed ONLY through systemd's credential
# mechanism; the process reads it once at startup via --keys-fd. Open mode
# (no protected buckets) is used when the file is empty.
LoadCredential=group-keys:/etc/hsync-bootnode/group-keys
LoadCredential=metrics-token:/etc/hsync-bootnode/metrics-token
# The metrics endpoint (/metrics) and the Prometheus text file are opt-in: an
# EMPTY credential keeps them off. To enable them, provision a token
# (`sudo sh -c 'openssl rand -hex 32 > /etc/hsync-bootnode/metrics-token'`) and add
# the flags in a drop-in; the exact ExecStart is in docs/operations.md,
# "Measure the node". The token is never passed on the command line.
ExecStart=/bin/sh -c 'if [ -r "$CREDENTIALS_DIRECTORY/group-keys" ]; then exec /usr/bin/hsync-bootnode run --host 0.0.0.0 --port 443 --identity /var/lib/hsync-bootnode/identity.pem --keys-fd 5 5<"$CREDENTIALS_DIRECTORY/group-keys"; else exec /usr/bin/hsync-bootnode run --host 0.0.0.0 --port 443 --identity /var/lib/hsync-bootnode/identity.pem; fi'
# Private node (protected-bucket policy node-wide): require a valid bucket_token on every frame.
# Needs a group key for EVERY bucket served and fails fast at startup (exit 2)
# without any key. The ExecStart above already passes --keys-fd whenever the
# credential exists, so uncommenting this line closes an otherwise open node.
#Environment=HSYNC_BOOTNODE_PRIVATE=1
# No-log: the bootstrap node writes nothing to disk (verified by the
# read-only-filesystem test suite). The banner on stdout is discarded; stderr
# goes to the journal so the always-on operational channel (warn/error) is
# visible with `journalctl -u hsync-bootnode`. That channel is peer-free by
# construction (see the "Diagnostics" section of usage.md). Never add --debug
# here: it emits peer identity and the journal is written to disk. Bound the
# journal if you need a retention policy:
#   /etc/systemd/journald.conf: SystemMaxUse=…, MaxRetentionSec=…
StandardOutput=null
StandardError=journal

# ---- Hardening ---------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=077
ReadWritePaths=

[Install]
WantedBy=multi-user.target
