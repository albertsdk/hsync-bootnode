[Unit]
Description=HSYNC P2P bootstrap node (boot/1, QUIC/UDP 443, no-log)
Documentation=https://github.com/albertosdk/hsync-bootnode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# No-log node: a dynamic system user (no /home, no persistent identity),
# strict filesystem sandbox, allowed to bind the QUIC/UDP port 443.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# The (optional) group-keys file is exposed ONLY through systemd's credential
# mechanism; the process reads it once at startup via --keys-fd. Open mode
# (no protected buckets) is used when the file has not been provisioned.
LoadCredential=group-keys:/etc/hsync-bootnode/group-keys
ExecStart=/bin/sh -c 'if [ -r "$CREDENTIALS_DIRECTORY/group-keys" ]; then exec /usr/bin/hsync-bootnode run --host 0.0.0.0 --port 443 --keys-fd 5 5<"$CREDENTIALS_DIRECTORY/group-keys"; else exec /usr/bin/hsync-bootnode run --host 0.0.0.0 --port 443; fi'
# Private node (D11 node-wide): require a valid bucket_token on every frame.
# Needs a group key for EVERY bucket served and fails fast at startup (exit 2)
# without any key. The ExecStart above already passes --keys-fd whenever the
# credential exists, so uncommenting this line closes an otherwise open node.
#Environment=HSYNC_BOOTNODE_PRIVATE=1
Restart=on-failure
RestartSec=5s
# No-log: the bootstrap node writes nothing to disk (verified by the
# read-only-filesystem test suite); console output is discarded.
StandardOutput=null
StandardError=null

# ---- Hardening ---------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=077
ReadWritePaths=

[Install]
WantedBy=multi-user.target
