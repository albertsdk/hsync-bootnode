# syntax=docker/dockerfile:1.6
#
# HSYNC Rendezvous — Linux builder image (amd64 / arm64 / armhf)
#
# Single-stage builder based on the official ``python:3.14.9-bookworm`` multi-arch
# image (Debian 12, glibc 2.36, CPython 3.14.9 built ``--enable-shared``), plus
# Poetry and ``dpkg-dev``. It is ready to:
#   1. invoke PyInstaller on the project sources mounted at /repo
#   2. assemble a .deb package with dpkg-deb
#
# The prebuilt upstream image is used instead of compiling CPython from source:
# it is published for linux/amd64, linux/arm64 and linux/arm/v7, and it keeps
# the CPython build (gcc/cc1) out of qemu-user emulation, where older qemu
# builds crash non-deterministically. ``--enable-shared`` (as built upstream)
# is required by PyInstaller.
#
# debian:bookworm targets Debian 12 and Ubuntu 22.04+ (the base is glibc 2.36;
# the bundled CPython and libgcc only require libc6 >= 2.35, which is the
# package's measured floor — decision 37).
#
# Built and consumed locally by:
#   compile.sh --target deb-all
#   compile.sh --target rpi
# Never published to any registry.

# Base image and target platform are parametrised so the same Dockerfile
# produces a builder for every CPU family. ``python:3.14.9-bookworm`` is a
# multi-arch manifest, so ``--platform`` alone selects the architecture:
#   linux/amd64 → amd64
#   linux/arm64 → arm64
#   linux/arm/v7 → armhf (armv7)
ARG BASE_IMAGE=python:3.14.9-bookworm
ARG TARGET_PLATFORM=linux/amd64

FROM --platform=${TARGET_PLATFORM} ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    LC_ALL=C.UTF-8 \
    P2PG=C.UTF-8 \
    PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=0 \
    POETRY_VIRTUALENVS_CREATE=true \
    POETRY_NO_INTERACTION=1

# PyInstaller tooling + .deb packaging + native-extension build dependencies.
# ``cryptography`` 50 publishes a manylinux_2_31_armv7l wheel (and manylinux2014
# x86_64/aarch64), so no source build is expected; the *-dev packages below remain
# a fallback for a future pin without a wheel.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        binutils \
        build-essential \
        pkg-config \
        libffi-dev \
        libssl-dev \
        zlib1g-dev \
        dpkg-dev \
        fakeroot \
    && rm -rf /var/lib/apt/lists/*

# Poetry — pinned to a known-good 2.x release for reproducibility. Version
# >= 2.0 is mandatory: the project declares its metadata via the PEP 621
# ``[project]`` table and the lock file is generated by Poetry 2.x; older
# 1.x releases ignore ``[project]`` and abort with "fields ... are required
# in package mode" while also rejecting the newer lock-file format.
RUN python3 -m pip install --no-cache-dir --prefer-binary \
        "poetry==2.5.1"

# Workdir is mounted by the caller (``-v "$PWD:/src"``).
WORKDIR /src

# Default command is a shell so the entrypoint can be overridden.
CMD ["bash"]
