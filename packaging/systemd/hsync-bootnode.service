# hsync-bootnode — hardened systemd unit (Linux, source install)
#
# Install:
#   sudo cp packaging/systemd/hsync-bootnode.service /etc/systemd/system/
#   sudo install -d -m 0750 /etc/hsync-bootnode
#   # optional (protected buckets only): provision the group-keys file, then
#   # enable the service. Without the file the node runs in open mode.
#   sudo install -m 0640 -o root -g root /path/to/group-keys \
#       /etc/hsync-bootnode/group-keys
#   sudo systemctl daemon-reload && sudo systemctl enable --now hsync-bootnode
#
# The group-keys file is exposed to the process ONLY through systemd's
# credential mechanism (fd, never a path inside the sandbox) and read once
# at startup via HSYNC_BOOTNODE_KEYS_FD. Nothing is written to disk (no-log);
# the only on-disk artifact is the opt-in persistent TLS identity under
# StateDirectory (the operator's own key+cert, never peer data).

[Unit]
Description=HSYNC P2P bootstrap node (boot/1, QUIC/UDP 443, no-log)
Documentation=https://github.com/albertosdk/hsync-bootnode/tree/main/hsync-bootnode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# No-log node: a dynamic system user (no /home, no persistent identity except
# the opt-in TLS identity), strict filesystem sandbox, allowed to bind the
# QUIC/UDP port 443. StateDirectory= makes /var/lib/hsync-bootnode writable for
# the identity file the node persists with --identity.
DynamicUser=yes
StateDirectory=hsync-bootnode
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# The (optional) group-keys file is exposed ONLY through systemd's credential
# mechanism; the process reads it once at startup via --keys-fd. Open mode
# (no protected buckets) is used when the file has not been provisioned.
LoadCredential=group-keys:/etc/hsync-bootnode/group-keys
ExecStart=/bin/sh -c 'if [ -r "$CREDENTIALS_DIRECTORY/group-keys" ]; then exec /usr/local/bin/hsync-bootnode run --host 0.0.0.0 --port 443 --identity /var/lib/hsync-bootnode/identity.pem --keys-fd 5 5<"$CREDENTIALS_DIRECTORY/group-keys"; else exec /usr/local/bin/hsync-bootnode run --host 0.0.0.0 --port 443 --identity /var/lib/hsync-bootnode/identity.pem; fi'
# Private node (protected-bucket policy node-wide): require a valid bucket_token on every frame.
# Needs a group key for EVERY bucket served and fails fast at startup (exit 2)
# without any key. The ExecStart above already passes --keys-fd whenever the
# credential exists, so uncommenting this line closes an otherwise open node.
#Environment=HSYNC_BOOTNODE_PRIVATE=1
Restart=on-failure
RestartSec=5s
# No-log: the bootstrap node writes nothing to disk (verified by the
# read-only-filesystem test suite); console output is discarded.
StandardOutput=null
StandardError=null

# ---- Hardening ---------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=077
ReadWritePaths=

[Install]
WantedBy=multi-user.target
