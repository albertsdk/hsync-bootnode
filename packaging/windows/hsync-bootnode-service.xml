<?xml version="1.0" encoding="utf-8"?>
<!-- hsync-bootnode — Windows service definition (WinSW v2)

Install:
  1. Install WinSW-x64.exe next to this file and rename it
     hsync-bootnode-service.exe (https://github.com/winsw/winsw).
  2. Edit the <executable>/<arguments> below to the real python/entry-point
     path of the venv.
  3. .\hsync-bootnode-service.exe install
     .\hsync-bootnode-service.exe start

The service runs in open mode (no protected buckets) unless a group-keys file
is provisioned and passed with the keys-file option; see docs/usage.md for the
keys contract.
-->
<service>
  <id>hsync-bootnode</id>
  <name>HSYNC bootnode</name>
  <description>HSYNC P2P bootstrap node (boot/1, QUIC/UDP 443, no-log)</description>

  <executable>C:\hsync-bootnode\.venv\Scripts\python.exe</executable>
  <arguments>-m hsync_bootnode run --listen-host 0.0.0.0 --listen-port 443 --identity C:\ProgramData\hsync-bootnode\identity.pem</arguments>
  <workingdirectory>C:\hsync-bootnode</workingdirectory>

  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5000"/>

  <!-- Protected buckets / private node: create the keys file (one
       bucket=<hex-group-key> line per protected bucket) and either add the
       keys-file option pointing at it to the <arguments> above, or uncomment
       HSYNC_BOOTNODE_KEYS_FILE below. For a fully private node (every bucket
       gated) also uncomment HSYNC_BOOTNODE_PRIVATE. The service reads the file
       once at startup and never writes it. -->
  <!--
  <env name="HSYNC_BOOTNODE_KEYS_FILE" value="C:\ProgramData\hsync-bootnode\group-keys"/>
  <env name="HSYNC_BOOTNODE_PRIVATE" value="1"/>
  -->

  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>

  <!-- Stderr carries the always-on, peer-free operational channel (warn/error):
       "append" keeps it in hsync-bootnode-service.err.log next to the service
       (rotate it, e.g. with the WinSW roll options if you need a bound). Peer
       identity is emitted by the debug flag only. -->
  <log mode="append"/>
</service>
