#!/bin/sh
#
# postinst — Debian maintainer script, runs after package installation.
#
# Creates the directory holding the (out-of-package) group-keys file, reloads
# the systemd manager and prints the opt-in enable command. A fresh install NEVER
# enables or starts the service: the administrator opts in explicitly with
# ``systemctl enable --now hsync-bootnode.service``. An upgrade only brings back
# a service the administrator had already enabled (prerm stopped it so the
# executable could be replaced).
# The process itself runs as a DynamicUser (no system user is created).

set -e

KEYS_DIR="/etc/hsync-bootnode"
KEYS_FILE="${KEYS_DIR}/group-keys"

# -- Group-keys directory -----------------------------------------------------
# The group-keys file is a SECRET the administrator provisions (never shipped in
# the package, never listed in conffiles). The directory is root-only so the
# file is protected by default. An empty file is created on install so the
# service unit's LoadCredential= always succeeds: an empty credential means
# open mode (no protected buckets), a provisioned one enables them.
if [ ! -d "${KEYS_DIR}" ]; then
    mkdir -p "${KEYS_DIR}"
fi
chown root:root "${KEYS_DIR}" 2>/dev/null || true
chmod 0750 "${KEYS_DIR}"
if [ ! -e "${KEYS_FILE}" ]; then
    : > "${KEYS_FILE}"
    chown root:root "${KEYS_FILE}" 2>/dev/null || true
    chmod 0600 "${KEYS_FILE}"
fi

# -- Metrics bearer token ------------------------------------------------------
# Same contract as the group keys: the credential source must exist for the
# unit's LoadCredential= to succeed. An EMPTY file keeps the opt-in /metrics
# endpoint off; write a token (at least 32 characters, e.g. `openssl rand -hex 32`)
# to enable it. It is a secret: root-only, never shipped.
METRICS_TOKEN_FILE="${KEYS_DIR}/metrics-token"
if [ ! -e "${METRICS_TOKEN_FILE}" ]; then
    : > "${METRICS_TOKEN_FILE}"
    chown root:root "${METRICS_TOKEN_FILE}" 2>/dev/null || true
    chmod 0600 "${METRICS_TOKEN_FILE}"
fi

# -- systemd ------------------------------------------------------------------
# daemon-reload picks up the replaced unit; the start is the upgrade path only
# (an enabled unit was stopped by prerm). is-enabled is false on a fresh install,
# so a first install still starts nothing.
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
    if systemctl is-enabled --quiet hsync-bootnode.service 2>/dev/null; then
        systemctl start hsync-bootnode.service 2>/dev/null || true
    fi
fi

echo "hsync-bootnode installed (service NOT enabled — no-log node, opt-in start)."
echo "  Enable with:   sudo systemctl enable --now hsync-bootnode.service"
echo "  Protected buckets / private node (optional — leave the file empty for open mode):"
echo "    sudo install -m 0640 /path/to/group-keys ${KEYS_FILE}"

exit 0
