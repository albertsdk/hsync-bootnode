<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- hsync-rendezvous — launchd service (macOS)

Install (system-wide daemon):
  sudo cp packaging/launchd/it.hsync.rendezvous.plist /Library/LaunchDaemons/
  sudo install -m 0640 -o root -g wheel /path/to/group-keys /etc/hsync-rendezvous/group-keys
  sudo launchctl rendezvous system /Library/LaunchDaemons/it.hsync.rendezvous.plist

The shell wrapper exposes the group-keys file as fd 3 (read once at startup
via HSYNC_RENDEZVOUS_KEYS_FD); the only thing written to disk (no-log) is the
persistent TLS identity under /usr/local/var/hsync-rendezvous (create the directory
first, e.g. `sudo install -d -m 0700 /usr/local/var/hsync-rendezvous`).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>it.hsync.rendezvous</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec /usr/local/bin/hsync-rendezvous run --listen-host 0.0.0.0 --listen-port 443 --identity /usr/local/var/hsync-rendezvous/identity.pem --keys-fd 3 3&lt;/etc/hsync-rendezvous/group-keys</string>
    </array>

    <!-- Private node (protected-bucket policy node-wide): require a valid bucket_token on every
         frame. Uncomment to enable; the node then needs a group key for every
         bucket it serves and fails fast at startup when it has none. -->
    <!--
    <key>EnvironmentVariables</key>
    <dict>
        <key>HSYNC_RENDEZVOUS_PRIVATE</key>
        <string>1</string>
    </dict>
    -->

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>RootDirectory</key>
    <string>/</string>
    <key>Umask</key>
    <integer>7</integer>

    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <!-- Stderr carries the always-on, peer-free operational channel (warn/error):
         keep it in a file so a failed UPnP mapping or an unwritable readiness
         file is diagnosable. Rotate it with newsyslog or trim it periodically;
         peer identity is emitted by the debug flag only. -->
    <key>StandardErrorPath</key>
    <string>/var/log/hsync-rendezvous.err</string>
</dict>
</plist>
